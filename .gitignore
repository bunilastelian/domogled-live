# secrete — niciodata in git
.env

# date descarcate
data/
cache/
*.nc
*.SAFE/
*.tif
*.jp2

# produsele SEN3 se pastreaza local pentru hartile termice,
# dar ZIP-urile brute NU se comit (2MB bucata, se re-descarca)
live/state/frp/*.zip

# cache-urile produsului live (se refac la rulare)
live/state/burn/
live/state/img/
live/state/*.tmp
live/state/collector.lock
live/web/state/*.tmp

# analiza de incendiu: doar cache-ul, rezultatele CSV se comit
fire/cache/

# python
__pycache__/
*.pyc
.venv/
venv/

# log-uri de rulare (se scriu la fiecare ciclu, n-au ce cauta in git)
logs/

